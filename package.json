{
  "name": "arduino-remote",
  "version": "1.0.3",
  "private": true,
  "author": "امیررضا لطفی (https://amirlwf.ir)",
  "type": "module",
  "description": "ریموت کنترل دستگاه‌های آردوینو — TypeScript + React + Capacitor (Android)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types tests/unit.mjs",
    "postinstall": "node scripts/patch-capacitor-mirrors.js && node scripts/patch-bt-plugin.js",
    "android:sync": "npm run build && npx cap sync android && node scripts/patch-capacitor-mirrors.js && node scripts/patch-bt-plugin.js",
    "android:release": "npm run android:sync && node scripts/android-release.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "cordova-plugin-bluetooth-serial": "^0.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
